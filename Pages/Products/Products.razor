@page "/products"
@inject ILogger<Counter> logger;
@inject IProductService productService;
@inject NavigationManager NavigationManager;
@inject IJSRuntime JSRuntime;
@inject IToastService ToastService

<PageTitle>Products</PageTitle>

<ModuleTitle Title="Products" />

<div>
  <button class="btn btn-success" @onclick="@(() => NavigationManager.NavigateTo("/products/add"))">Nuevo</button>
</div>

@if (products.Count == 0)
{
  <p role="status">No productos disponibles.</p>
}
else
{
  <div class="row flex justify-content-center">
    @foreach (var product in products)
    {
      <div class="card col-3 mb-3">
        @* <li>@product.Title - @product.Price</li> *@
        <img src="@product.Images[0]" class="img-fluid rounded-start" alt="@product.Title" />
        <h1>@product.Title</h1>
        <p>@product.Description</p>
        <p>$@product.Price</p>
        <button class="btn btn-danger btn-delete" @onclick="() => DeleteProduct(product.Id)">Delete</button>
      </div>
    }
  </div>
}

@code {
  private List<Product> products = new List<Product>();

  protected override async Task OnInitializedAsync()
  {
    products = await productService.Get();
    logger.LogInformation("Se inicia el componente Products");
  }

  private async Task DeleteProduct(int productId)
  {
    if (await JSRuntime.InvokeAsync<bool>("confirm", $"¿Está seguro de que desea eliminar el producto con ID {productId}?"))
    {
      await productService.Delete(productId);
      ToastService.ShowSuccess("Registro guardado correctamente");
      products = await productService.Get();
    }
  }
}